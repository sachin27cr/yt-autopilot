# Copy into Railway -> Variables (never commit real values)

# Claude (scripts + ideas)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# ElevenLabs (one distinct voice per channel)
ELEVENLABS_API_KEY=
VOICE_ID_A=
VOICE_ID_B=

# Pexels stock footage (free key: pexels.com/api)
PEXELS_API_KEY=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# YouTube (one Google Cloud OAuth client, one refresh token per channel)
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN_A=
YT_REFRESH_TOKEN_B=

# Channel names
CHANNEL_NAME_A=Chart Ledger
CHANNEL_NAME_B=Market Mechanics

# Which channels get scheduled idea pushes (A first, then A,B)
ENABLED_CHANNELS=A

# Storage (Railway volume mounted at /data)
WORK_DIR=/data

# 1 = render and preview but never upload (use for the first test runs)
DRY_RUN_UPLOAD=1
